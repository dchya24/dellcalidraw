# App Environment (development | production)
# When set to "development", AI request logs are stored to PostgreSQL
APP_ENV=development

# Server Configuration
EXCALIDRAW_SERVER_PORT=8080
EXCALIDRAW_SERVER_READ_TIMEOUT=10s
EXCALIDRAW_SERVER_WRITE_TIMEOUT=10s
EXCALIDRAW_SERVER_IDLE_TIMEOUT=60s

# WebSocket Configuration
EXCALIDRAW_WEBSOCKET_READ_BUFFER_SIZE=1024
EXCALIDRAW_WEBSOCKET_WRITE_BUFFER_SIZE=1024
EXCALIDRAW_WEBSOCKET_PING_PERIOD=54s
EXCALIDRAW_WEBSOCKET_PONG_WAIT=60s
# Phase 11–12: per-room AES-256-GCM message encryption (defense in depth on top of TLS).
# Requires the database (key persisted on rooms.encryption_key). Defaults to true.
EXCALIDRAW_WEBSOCKET_ENCRYPTION_ENABLED=true

# Room Configuration
EXCALIDRAW_ROOM_CAPACITY=50
EXCALIDRAW_ROOM_INACTIVITY_TIMEOUT=1h
EXCALIDRAW_ROOM_CLEANUP_INTERVAL=10m

# Database (PostgreSQL)
EXCALIDRAW_DATABASE_HOST=localhost
EXCALIDRAW_DATABASE_PORT=5432
EXCALIDRAW_DATABASE_USER=excalidraw
EXCALIDRAW_DATABASE_PASSWORD=excalidraw
EXCALIDRAW_DATABASE_DBNAME=excalidraw
EXCALIDRAW_DATABASE_SSLMODE=disable
EXCALIDRAW_DATABASE_MAX_OPEN_CONNS=25
EXCALIDRAW_DATABASE_MAX_IDLE_CONNS=5
EXCALIDRAW_DATABASE_CONN_MAX_LIFETIME=5m

# Storage (MinIO/S3)
EXCALIDRAW_STORAGE_ENDPOINT=localhost:9000
EXCALIDRAW_STORAGE_ACCESS_KEY=minioadmin
EXCALIDRAW_STORAGE_SECRET_KEY=minioadmin
EXCALIDRAW_STORAGE_BUCKET=excalidraw-files
EXCALIDRAW_STORAGE_REGION=us-east-1
EXCALIDRAW_STORAGE_USE_SSL=false
EXCALIDRAW_STORAGE_PUBLIC=false

# Auth (JWT)
EXCALIDRAW_AUTH_SECRET_KEY=change-me-in-production-please
EXCALIDRAW_AUTH_ACCESS_TOKEN_TTL=15m
EXCALIDRAW_AUTH_REFRESH_TOKEN_TTL=168h

# AI (OpenAI/Anthropic Compatible)
EXCALIDRAW_AI_PROVIDER=openai
EXCALIDRAW_AI_API_KEY=
EXCALIDRAW_AI_BASE_URL=
EXCALIDRAW_AI_MODEL=gpt-4o
EXCALIDRAW_AI_MAX_TOKENS=4096
EXCALIDRAW_AI_TEMPERATURE=0.7

# AI memory
EXCALIDRAW_AI_MEMORY_ENABLED=true
EXCALIDRAW_AI_EMBEDDING_MODEL=text-embedding-3-small
EXCALIDRAW_AI_SUMMARY_MODEL=gpt-4o-mini
EXCALIDRAW_AI_MEMORY_TOP_K=5
EXCALIDRAW_AI_MEMORY_MAX_TOKENS=800

# Logging
EXCALIDRAW_LOG_LEVEL=info
EXCALIDRAW_LOG_FORMAT=json

# CORS Configuration
EXCALIDRAW_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
EXCALIDRAW_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
EXCALIDRAW_CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Request-ID
EXCALIDRAW_CORS_ALLOW_CREDENTIALS=true
EXCALIDRAW_CORS_MAX_AGE=300

# Security headers (always-on: X-Content-Type-Options, X-Frame-Options,
# Referrer-Policy, Permissions-Policy, COOP, CSP). HSTS is opt-in: only
# turn it on once the deployment is reliably behind TLS, otherwise the
# header pins browsers to a broken state.
EXCALIDRAW_SECURITY_ENABLE_HSTS=false
EXCALIDRAW_SECURITY_HSTS_MAX_AGE=31536000
EXCALIDRAW_SECURITY_HSTS_PRELOAD=false
# Override CSP to relax for analytics/CDNs etc. Empty = use built-in default.
EXCALIDRAW_SECURITY_CSP=

# Email delivery (password reset, invitations).
# Provider "log" prints to slog and is the dev default; switch to
# "smtp" in production. When provider is "smtp" but Host or From are
# missing the package falls back to LogSender so the app still boots.
EXCALIDRAW_EMAIL_PROVIDER=log
# RFC 5322 mailbox, e.g. "Excalidraw <no-reply@example.com>"
EXCALIDRAW_EMAIL_FROM=
# Public app base URL used to build links inside emails (no trailing slash).
EXCALIDRAW_EMAIL_BASE_URL=http://localhost:3000
# SMTP relay (only required when provider=smtp).
EXCALIDRAW_EMAIL_SMTP_HOST=
EXCALIDRAW_EMAIL_SMTP_PORT=587
EXCALIDRAW_EMAIL_SMTP_USERNAME=
EXCALIDRAW_EMAIL_SMTP_PASSWORD=
# Upgrade to TLS via STARTTLS after EHLO. Default true; set false only
# for trusted private networks where the relay doesn't support it.
EXCALIDRAW_EMAIL_SMTP_STARTTLS=true
