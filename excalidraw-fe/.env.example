# Optional. Leave UNSET for normal dev: the app falls back to same-origin
# URLs (window.location.origin) and the Vite dev server proxies /api to the
# backend (default target http://localhost:8081). Production images are built
# WITHOUT these vars and rely on the reverse proxy (Traefik) to route /api
# and /ws to the backend. Set VITE_API_URL only when you need to override the
# Vite proxy target, e.g. to point the dev server at a remote backend.
#
# Backend API URL (for REST endpoints) — leave unset to use the Vite proxy
# VITE_API_URL=http://localhost:8081

# WebSocket URL for backend connection
VITE_WS_URL=ws://localhost:8081/ws

# Frontend dev server port (default: 5173)
VITE_PORT=3002
SHOW_TOOLBAR=false
