# Optional. Production images are built WITHOUT these vars: the app falls
# back to same-origin URLs and relies on the reverse proxy (Traefik) to
# route /api and /ws to the backend. Set these only for local dev when
# you need to override the Vite proxy target.
#
# Backend API URL (for REST endpoints)
VITE_API_URL=http://localhost:8080

# WebSocket URL for backend connection
VITE_WS_URL=ws://localhost:8080/ws

# Frontend dev server port (default: 5173)
VITE_PORT=3002
SHOW_TOOLBAR=false
