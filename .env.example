# Root environment for `docker-compose.yml` (production-style stack).
#
# Copy to `.env` and fill in real values. Compose auto-loads this file
# when running `docker compose up`. Backend container reads these via the
# `environment:` block in compose.yml.
#
# PostgreSQL and MinIO/S3 are external dependencies in this compose file.
# Point the backend at whatever managed or self-hosted instance you run.

# ---------- Image tags (CD pipeline pushes to ghcr.io) ----------
# Override these to deploy a specific image instead of building locally:
#   BACKEND_IMAGE=ghcr.io/<owner>/<repo>/excalidraw-be:main
#   FRONTEND_IMAGE=ghcr.io/<owner>/<repo>/excalidraw-fe:main
BACKEND_IMAGE=excalidraw-be:latest
FRONTEND_IMAGE=excalidraw-fe:latest

# ---------- Host port bindings ----------
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---------- App ----------
APP_ENV=production

# ---------- Database (PostgreSQL) ----------
# Required. Use `host.docker.internal` to reach a Postgres on the host
# machine, or a DNS name like `db.internal` / `<rds-endpoint>` for managed.
EXCALIDRAW_DATABASE_HOST=
EXCALIDRAW_DATABASE_PORT=5432
EXCALIDRAW_DATABASE_USER=excalidraw
EXCALIDRAW_DATABASE_PASSWORD=
EXCALIDRAW_DATABASE_DBNAME=excalidraw
# Use `require` for managed providers, `disable` only for trusted private nets.
EXCALIDRAW_DATABASE_SSLMODE=require

# ---------- Object storage (S3-compatible) ----------
# Examples:
#   AWS S3:       endpoint=s3.<region>.amazonaws.com  use_ssl=true
#   Cloudflare R2: endpoint=<accountid>.r2.cloudflarestorage.com use_ssl=true
#   Self MinIO:   endpoint=minio.internal:9000  use_ssl=false
EXCALIDRAW_STORAGE_ENDPOINT=
EXCALIDRAW_STORAGE_ACCESS_KEY=
EXCALIDRAW_STORAGE_SECRET_KEY=
EXCALIDRAW_STORAGE_BUCKET=excalidraw-files
EXCALIDRAW_STORAGE_REGION=us-east-1
EXCALIDRAW_STORAGE_USE_SSL=true

# ---------- WebSocket encryption (Phase 11–12) ----------
# Per-room AES-256-GCM message encryption on top of TLS. Defense in depth
# against intermediate proxies and traffic captures. Requires the database
# (key is persisted on the rooms table). Defaults to true.
EXCALIDRAW_WEBSOCKET_ENCRYPTION_ENABLED=true

# ---------- Email delivery (password reset, invitations) ----------
# Provider "log" prints to slog (dev default); use "smtp" in production.
# When the SMTP relay isn't configured, the app falls back to LogSender
# instead of failing.
EXCALIDRAW_EMAIL_PROVIDER=log
EXCALIDRAW_EMAIL_FROM=
EXCALIDRAW_EMAIL_BASE_URL=https://your-app.example.com
EXCALIDRAW_EMAIL_SMTP_HOST=
EXCALIDRAW_EMAIL_SMTP_PORT=587
EXCALIDRAW_EMAIL_SMTP_USERNAME=
EXCALIDRAW_EMAIL_SMTP_PASSWORD=
EXCALIDRAW_EMAIL_SMTP_STARTTLS=true

# ---------- Backup service (opt-in) ----------
# Postgres dumps written nightly to S3 under BACKUP_S3_PREFIX, encrypted
# with gpg (AES256, symmetric). Enable by adding `--profile backup` to
# docker compose, e.g.:
#   docker compose --profile backup up -d backup
#
# Required when the backup service runs:
BACKUP_GPG_PASSPHRASE=
# Optional overrides:
# BACKUP_CRON="0 2 * * *"        # crontab format, container time
# BACKUP_RETENTION_DAYS=14
# BACKUP_S3_PREFIX=backups/postgres
# BACKUP_RUN_ON_START=false      # set true to run a one-shot backup at boot
# TZ=UTC
